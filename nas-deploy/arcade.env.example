# NAS 部署凭据模板
# ------------------------------------------------------------
# 用法：把本文件复制为 arcade.env，填入真实值。
# arcade.env 已被 .gitignore 排除，不会提交到仓库。
# ------------------------------------------------------------
ARCADE_HOST=192.168.1.100
ARCADE_PORT=22
ARCADE_USER=your_ssh_user
ARCADE_PWD=your_ssh_password
ARCADE_BASE=/vol1/1000/docker/game-arcade
